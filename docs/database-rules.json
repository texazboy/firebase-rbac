{
  "rules": {

    // ══════════════════════════════════════════════════════════════
    // NÓ: /users — Perfis de todos os usuários
    //
    // Permissões:
    //   Admin → lê e escreve QUALQUER perfil
    //   User  → lê e escreve APENAS seu próprio perfil
    //
    // Proteção anti-escalação:
    //   O campo "role" só aceita "admin" ou "user".
    //   Somente um admin pode definir role = "admin".
    //   Um user tentando se autopromover será rejeitado.
    //
    // Validação:
    //   Campos obrigatórios: name, email, role, createdAt
    //   name: string, 2-100 caracteres
    //   email: string contendo @ e .
    //   Campos extras ($other) são rejeitados → evita poluição do banco
    //
    // Indexação:
    //   .indexOn em "role" e "email" para queries eficientes
    // ══════════════════════════════════════════════════════════════
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": ["role", "email"],
      "$uid": {
        ".read":  "$uid === auth.uid",
        ".write": "$uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".validate": "newData.hasChildren(['name', 'email', 'role', 'createdAt'])",

        "name":      { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100" },
        "email":     { ".validate": "newData.isString() && newData.val().contains('@') && newData.val().contains('.')" },
        "role":      { ".validate": "(newData.val() === 'admin' || newData.val() === 'user') && (root.child('users').child(auth.uid).child('role').val() === 'admin' || newData.val() === 'user' || !root.child('users').child(auth.uid).exists())" },
        "createdAt": { ".validate": "newData.isString()" },
        "lastLogin": { ".validate": "newData.isString()" },
        "$other":    { ".validate": false }
      }
    },

    // ══════════════════════════════════════════════════════════════
    // NÓ: /admin-data — Dados exclusivos para administradores
    //
    // Permissões:
    //   Admin → leitura e escrita total
    //   User  → PERMISSION_DENIED em qualquer operação
    //
    // Sub-nós:
    //   /reports      → Relatórios (validação: title, content, createdBy, createdAt obrigatórios)
    //   /system-logs  → Logs de auditoria (validação: action, performedBy, timestamp obrigatórios)
    //   /settings     → Configurações globais (validação de tipo: boolean, number, string)
    //
    // Indexação em reports e system-logs para queries ordenadas
    // ══════════════════════════════════════════════════════════════
    "admin-data": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",

      "reports": {
        ".indexOn": ["priority", "createdAt"],
        "$reportId": {
          ".validate": "newData.hasChildren(['title', 'content', 'createdBy', 'createdAt'])",
          "title":     { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200" },
          "content":   { ".validate": "newData.isString()" },
          "createdBy": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "createdAt": { ".validate": "newData.isString()" },
          "priority":  { ".validate": "newData.val() === 'alta' || newData.val() === 'media' || newData.val() === 'baixa'" }
        }
      },

      "system-logs": {
        ".indexOn": ["timestamp", "action"],
        "$logId": {
          ".validate": "newData.hasChildren(['action', 'performedBy', 'timestamp'])",
          "action":      { ".validate": "newData.isString()" },
          "performedBy": { ".validate": "newData.isString()" },
          "timestamp":   { ".validate": "newData.isString()" },
          "details":     { ".validate": "newData.isString()" },
          "targetUser":  { ".validate": "newData.isString()" }
        }
      },

      "settings": {
        ".validate": "newData.hasChildren(['maintenanceMode', 'appVersion'])",
        "maintenanceMode": { ".validate": "newData.isBoolean()" },
        "maxUsersAllowed": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "appVersion":      { ".validate": "newData.isString()" }
      }
    },

    // ══════════════════════════════════════════════════════════════
    // NÓ: /public-data — Dados públicos (avisos, comunicados)
    //
    // Permissões:
    //   Qualquer usuário autenticado → leitura
    //   Admin → escrita (criar/editar avisos)
    //   User  → NÃO pode escrever
    //
    // Indexação em announcements para ordenar por data e filtrar ativos
    // ══════════════════════════════════════════════════════════════
    "public-data": {
      ".read":  "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",

      "announcements": {
        ".indexOn": ["createdAt", "active"],
        "$announcementId": {
          ".validate": "newData.hasChildren(['title', 'content', 'createdBy', 'createdAt'])",
          "title":     { ".validate": "newData.isString() && newData.val().length >= 1" },
          "content":   { ".validate": "newData.isString()" },
          "createdBy": { ".validate": "newData.isString()" },
          "createdAt": { ".validate": "newData.isString()" },
          "active":    { ".validate": "newData.isBoolean()" }
        }
      }
    },

    // ══════════════════════════════════════════════════════════════
    // NÓ: /user-data — Dados pessoais (isolados por UID)
    //
    // Permissões:
    //   Cada user → lê e escreve APENAS em /user-data/{seu-uid}
    //   Admin → pode LER qualquer /user-data/{uid} (auditoria)
    //   Admin → NÃO pode ESCREVER nos dados de outros (privacidade)
    //
    // Validação:
    //   notes: title, content, createdAt obrigatórios
    //   preferences: theme só aceita "light" ou "dark", notifications é boolean
    // ══════════════════════════════════════════════════════════════
    "user-data": {
      "$uid": {
        ".read":  "$uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".write": "$uid === auth.uid",

        "notes": {
          ".indexOn": ["createdAt"],
          "$noteId": {
            ".validate": "newData.hasChildren(['title', 'content', 'createdAt'])",
            "title":     { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200" },
            "content":   { ".validate": "newData.isString()" },
            "createdAt": { ".validate": "newData.isString()" }
          }
        },
        "preferences": {
          "theme":         { ".validate": "newData.val() === 'light' || newData.val() === 'dark'" },
          "notifications": { ".validate": "newData.isBoolean()" }
        }
      }
    }
  }
}
